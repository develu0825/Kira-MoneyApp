# Kira collector 설정
# 이 파일을 복사해서 ".env" 로 만들고 값을 채우세요:  cp .env.example .env
# ⚠️ .env 는 절대 커밋 금지 (.gitignore에 포함됨). 키·암호를 누구에게도 보내지 마세요.

# ── CODEF (https://codef.io 가입 후 콘솔에서 발급) ──
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# ── 데이터 암호 (★ 폰 앱에서 입력하는 값과 반드시 동일) ──
# 길고 추측 어려운 문장 권장. 분실하면 데이터 복호화가 불가능합니다.
KIRA_PASSPHRASE=

# ── 본인 인증정보 (간편인증용) ──
MY_NAME=
MY_BIRTH=          # YYMMDD (생년월일)
MY_PHONE=          # 01012345678

# 간편인증 수단: 1=카카오톡(기본) 2=페이코 3=삼성패스 4=KB 5=PASS 6=네이버 7=신한 8=토스
SIMPLE_AUTH_LEVEL=1
# TELECOM=          # PASS(5) 쓸 때만: 0=SKT 1=KT 2=LGU+
# LOGIN_TYPE=5      # 간편인증이 CF-04000이면 6으로 시도

# 계좌는 쉼표로 여러 개 (가상계좌도 번호만 추가). 예: 1111111,2222222,가상계좌번호
KAKAO_ACCOUNTS=    # 카카오뱅크 계좌들 (- 없이)
TOSS_ACCOUNTS=     # 토스뱅크 계좌들 (- 없이)

# ── (선택) 동작 옵션 ──
# KIRA_PUSH=1      # 1=publish가 git push까지 (기본), 0=파일만 생성
